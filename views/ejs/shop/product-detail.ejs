<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <style>
      body {
        font-family: Arial, sans-serif;
      }
      .products-container {
        display: flex;
        flex-wrap: wrap;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 20px;
        padding: 20px;
      }
      .product-card {
        width: 100%;
        max-width: 300px; /* THIS is important */
        border: 1px solid #ccc;
        border-radius: 10px;
        overflow: hidden;
        padding: 10px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        background: #fff;
        text-align: center;
      }
      .product-card img {
        width: 100%;
        height: 200px;
        object-fit: cover;
        border-bottom: 1px solid #eee;
      }
      .product-card h2 {
        font-size: 1.2rem;
        margin: 10px 0;
      }
      .product-card p {
        margin: 5px 0;
      }
      .no-products {
        text-align: center;
        margin-top: 50px;
        font-size: 2rem;
      }

      .btn {
        width: 200px;
        padding: 20px;
      }
    </style>
    <link rel="stylesheet" href="/css/main.css" />
  </head>
  <body>
    <%- include('../includes/navigation.ejs') %>
    <main>
      <h1 style="text-align: center">My Products</h1>
      <div class="products-container">
        <div class="product-card">
          <img src="<%= product.imageUrl %>" alt="<%= product.title %> Image" />
          <h2><%= product.title %></h2>
          <p><strong>Price: </strong> $<%= product.price %></p>
          <p><strong>Description: </strong><%= product.description %></p>
        </div>
        <form method="post" action="/cart">
          <button class="btn">Add to Cart</button>
          <input hidden name="productId" value="<%= product.id %>" />
          <input hidden name="productPrice" value="<%= product.price %>" />
        </form>
      </div>
    </main>
  </body>
</html>
